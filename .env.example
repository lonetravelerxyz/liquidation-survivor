# ---- runtime ----
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/liquidation-survivor.db
PUBLIC_BASE_URL=                      # https origin, no trailing slash; used for Telegram webhook + links

# ---- chain ----
# Which deployment the app serves. "mainnet" (196, real Aave) or "testnet" (1952, MockPool).
CHAIN=testnet
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
# SurvivalGuard addresses per network (filled after deploy; see docs/deployments.md)
GUARD_ADDRESS_MAINNET=
GUARD_ADDRESS_TESTNET=
# Aave Pool per network (mainnet is the real Aave V3 pool; testnet is our MockPool)
POOL_ADDRESS_MAINNET=0xE3F3Caefdd7180F884c01E57f65Df979Af84f116
POOL_ADDRESS_TESTNET=
# Keeper signer (calls SurvivalGuard.protect). Gas dust only. Never the deployer/owner key.
KEEPER_PRIVATE_KEY=
# Sentinel cadence (ms)
SENTINEL_INTERVAL_MS=60000

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional fallback when no Anthropic key: OpenRouter (Anthropic models via chat completions)
OPENROUTER_API_KEY=
DEPLOYER_PRIVATE_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- optional: QuickNode X Layer webhook for event-driven rechecks ----
QUICKNODE_WEBHOOK_SECURITY_TOKEN=
